# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — `.env` is the committed default; never commit local overrides
.env.local
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo

# misc dev tooling
.playwright-mcp
.crossfire

# in-progress collection ID snapshots
/data/collections/.progress/
scripts/__pycache__/

# local postgres dumps (multi-GB)
*.dump
